---
import '../styles/global.css';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  type?: 'website' | 'article';
  publishedDate?: Date;
  tags?: string[];
  schemas?: object[];
  noindex?: boolean;
  ogImage?: string;
}

const { title, description, type, publishedDate, tags, schemas, noindex, ogImage } = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <BaseHead
      title={title}
      description={description}
      type={type}
      publishedDate={publishedDate}
      tags={tags}
      schemas={schemas}
      noindex={noindex}
      ogImage={ogImage}
    />
  </head>
  <body class="bg-white text-gray-800 antialiased">
    <div class="mx-auto max-w-2xl px-4">
      <Header />
      <main class="min-h-[60vh] py-4">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
