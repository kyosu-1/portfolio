---
import { canonicalUrl } from '../lib/url';

interface Props {
  title: string;
  description: string;
  type?: 'website' | 'article';
  publishedDate?: Date;
  tags?: string[];
  schemas?: object[];
  /** true のとき noindex を出す。canonical が存在しないURL（404 など）を指すページ用 */
  noindex?: boolean;
  /** ページ相対パス（例: /og/blog/introducing-batcha.png）。省略時は og:image を出さない */
  ogImage?: string;
}

const {
  title,
  description,
  type = 'website',
  publishedDate,
  tags = [],
  schemas = [],
  noindex = false,
  ogImage,
} = Astro.props;

// Astro.site は astro.config.mjs の site。sitemap の必須要件でもある。
const canonical = canonicalUrl(Astro.url.pathname, Astro.site!);
// og:image / twitter:image も canonical と同じく Astro.site 基準の絶対URLにする
const ogImageUrl = ogImage ? new URL(ogImage, Astro.site!).href : undefined;
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<link rel="icon" href="/favicon.ico" />

<title>{title}</title>
<meta name="description" content={description} />
{/* noindex のページ（404 など）は canonical の宛先URLが存在しないため出さない */}
{!noindex && <link rel="canonical" href={canonical} />}
{noindex && <meta name="robots" content="noindex" />}

<meta property="og:type" content={type} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{!noindex && <meta property="og:url" content={canonical} />}
<meta property="og:site_name" content="kyosu.dev" />
<meta property="og:locale" content="ja_JP" />
{publishedDate && (
  <meta property="article:published_time" content={publishedDate.toISOString()} />
)}
{tags.map((tag) => <meta property="article:tag" content={tag} />)}

{/* noindex のページには対応する canonical URL が無い（404 など）ため、
    それを指す og:image / twitter:image も出さない */}
{!noindex && ogImageUrl && (
  <>
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:image" content={ogImageUrl} />
  </>
)}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />

<link rel="alternate" type="application/rss+xml" title="kyosu.dev" href="/rss.xml" />

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
  rel="stylesheet"
/>

{schemas.map((schema) => (
  <script type="application/ld+json" set:html={JSON.stringify(schema)} is:inline />
))}
